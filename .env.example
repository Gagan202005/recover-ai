# ============================================
# RecoverAI — Environment Variables
# ============================================
# Copy this to .env and fill in your real values

# --- Supabase (Cloud PostgreSQL + Realtime) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Pinecone (Cloud Vector DB for RAG) ---
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=recoverai

# --- Razorpay (Test Mode) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-test-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# --- Twilio (WhatsApp + SMS + Voice) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Resend (Email) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=RecoverAI <recover@yourdomain.com>

# --- Google AI (Gemini) ---
GOOGLE_API_KEY=your-gemini-api-key

# --- Demo Configuration ---
DEMO_PHONE_NUMBER=+91xxxxxxxxxx
DEMO_EMAIL=your-email@gmail.com
DEMO_CUSTOMER_NAME=Gagan Singhal

# --- App Settings ---
MERCHANT_NAME=StyleBazaar
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173
