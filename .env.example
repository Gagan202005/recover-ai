# =====================================================================
# RecoverAI — Environment Variables (.env.example)
# =====================================================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# All services below have a free tier — total cost: ₹0
# =====================================================================

# ── Supabase (Cloud PostgreSQL + Realtime + Auth) ────────────────────
# Create a project at https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ── Pinecone (Serverless Vector DB for RAG) ──────────────────────────
# Create a free index at https://app.pinecone.io
# Dimension: 3072 (gemini-embedding-001), Metric: cosine, Cloud: AWS us-east-1
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=recoverai

# ── Razorpay (Test Mode — Payment Links, Orders, Subscriptions) ──────
# Get test keys from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-test-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── Twilio (SMS + Voice Calls) ───────────────────────────────────────
# Sign up at https://www.twilio.com (free trial includes SMS + Voice)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── Wabery (Live Two-Way WhatsApp — Cloud API Sandbox) ───────────────
# Sign up at https://wabery.com → Get sandbox credentials
# Enables real-time bidirectional WhatsApp messaging with AI replies
WABERY_API_KEY=wab_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WABERY_CHANNEL_ID=your-channel-id
WABERY_CONVERSATION_ID=your-conversation-id

# ── MSG91 (India SMS + WhatsApp — DLT-Compliant CPaaS) ───────────────
# Sign up at https://msg91.com → Dashboard → Auth Key
MSG91_AUTH_KEY=your-msg91-auth-key

# ── Fast2SMS (Quick SMS for India — No DLT Required) ─────────────────
# Sign up at https://www.fast2sms.com → Dashboard → Dev API
FAST2SMS_API_KEY=your-fast2sms-api-key

# ── Resend (Transactional Email) ─────────────────────────────────────
# Sign up at https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=RecoverAI <recover@yourdomain.com>

# ── Google AI (Gemini LLM + Embeddings) ──────────────────────────────
# Get API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Demo Configuration ───────────────────────────────────────────────
# Your real phone/email for live demo (WhatsApp, SMS, Email, Voice)
DEMO_PHONE_NUMBER=+91xxxxxxxxxx
DEMO_EMAIL=your-email@gmail.com
DEMO_CUSTOMER_NAME=Your Name

# ── App Settings ─────────────────────────────────────────────────────
MERCHANT_NAME=StyleBazaar
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173
