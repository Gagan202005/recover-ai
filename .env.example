# =====================================================================
# 🧠 RecoverAI — Environment Variables (.env.example)
# =====================================================================
# Autonomous AI Revenue Recovery Agent Platform
# Razorpay Buildathon 2026 — Track 03: AI Revenue Recovery
#
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# All services below have a FREE TIER — total cost: ₹0
# =====================================================================


# ═══════════════════════════════════════════════════════════════════════
# ── Supabase (Cloud PostgreSQL + Realtime + Row-Level Security) ──────
# ═══════════════════════════════════════════════════════════════════════
# Create a project at https://supabase.com → Project Settings → API
# Used for: Transactions DB, Recovery Actions audit trail, Agent Debates,
#           Promise-to-Pay tracking, Channel Messages, A/B Test state,
#           Supabase Realtime (WebSocket) for live dashboard updates.
# Tables: 7 (customers, transactions, recovery_actions, agent_debates,
#          promise_to_pay, channel_messages, ab_tests)
# Realtime: Enabled on 5 tables for live dashboard streaming
# Indexes: 7 optimized indexes for agent query performance

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json


# ═══════════════════════════════════════════════════════════════════════
# ── Pinecone (Serverless Vector DB — RAG Knowledge Engine) ────────────
# ═══════════════════════════════════════════════════════════════════════
# Create a free index at https://app.pinecone.io
# Index Config:
#   - Dimension: 3072 (gemini-embedding-001 output dimension)
#   - Metric: cosine
#   - Cloud: AWS us-east-1 (Serverless)
# 4 Namespaces:
#   KB1: error_codes     → 24 Razorpay error codes (static, ingested once)
#   KB2: compliance      → 10 RBI/TRAI regulations (static, ingested once)
#   KB3: recovery_playbook → Self-evolving (Analyst agent writes after every case)
#   KB4: customer_context  → Self-evolving (populated during batch processing)

PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=recoverai


# ═══════════════════════════════════════════════════════════════════════
# ── Razorpay (Test Mode — Payment Links, Orders, Checkout, Webhooks) ──
# ═══════════════════════════════════════════════════════════════════════
# Get test keys from https://dashboard.razorpay.com → Settings → API Keys
# Used for: Real Razorpay Checkout popup integration, Payment Link generation,
#           Order creation, Subscription/Invoice creation, Webhook events
#           (payment.captured, payment.failed), and failed payment queries.
# MCP Server: razorpay-recovery (7 tools)

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-test-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret


# ═══════════════════════════════════════════════════════════════════════
# ── Twilio (SMS + Voice Calls + WhatsApp Fallback) ────────────────────
# ═══════════════════════════════════════════════════════════════════════
# Sign up at https://www.twilio.com (free trial includes SMS + Voice)
# Used for: SMS delivery (fallback provider #3), AI Voice Calls with
#           dynamic Hinglish TTS via Twimlet, WhatsApp Sandbox (fallback).
# Voice: Twimlet TTS for AI-generated Hinglish voice call scripts.

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886


# ═══════════════════════════════════════════════════════════════════════
# ── Wabery (Live Two-Way WhatsApp — Cloud API Sandbox) ────────────────
# ═══════════════════════════════════════════════════════════════════════
# Sign up at https://wabery.com → Get sandbox credentials
# Enables real-time bidirectional WhatsApp messaging with AI replies.
# The polling listener (3s interval) continuously monitors for inbound
# customer messages, routes them to the Gemini Conversational Agent,
# and dispatches context-aware AI replies back to WhatsApp.
# Deduplication: Shared OrderedDict (max 2000 entries) prevents
#               double-replies across polling + webhook paths.

WABERY_API_KEY=wab_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WABERY_CHANNEL_ID=your-channel-id
WABERY_CONVERSATION_ID=your-conversation-id


# ═══════════════════════════════════════════════════════════════════════
# ── MSG91 (India SMS + WhatsApp — DLT-Compliant CPaaS) ────────────────
# ═══════════════════════════════════════════════════════════════════════
# Sign up at https://msg91.com → Dashboard → Auth Key
# Used as: SMS fallback provider #2 in the smart SMS routing chain.
# Routing priority: Fast2SMS → MSG91 → Twilio

MSG91_AUTH_KEY=your-msg91-auth-key


# ═══════════════════════════════════════════════════════════════════════
# ── Fast2SMS (Quick SMS for India — No DLT Required) ──────────────────
# ═══════════════════════════════════════════════════════════════════════
# Sign up at https://www.fast2sms.com → Dashboard → Dev API
# Used as: SMS primary provider #1 (fastest, supports custom text).
# Route: Quick SMS ('q') — supports payment links in message body.

FAST2SMS_API_KEY=your-fast2sms-api-key


# ═══════════════════════════════════════════════════════════════════════
# ── Resend (Transactional Email with Styled HTML Templates) ───────────
# ═══════════════════════════════════════════════════════════════════════
# Sign up at https://resend.com → API Keys
# Used for: Styled HTML recovery emails with 1-click payment CTA buttons,
#           checkout abandonment recovery emails with discount coupons,
#           B2B invoice overdue email follow-ups.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=RecoverAI <recover@yourdomain.com>


# ═══════════════════════════════════════════════════════════════════════
# ── Google AI (Gemini LLM + Embeddings — Multi-Agent Intelligence) ────
# ═══════════════════════════════════════════════════════════════════════
# Get API key from https://aistudio.google.com/apikey
# Used by ALL 7 agents for:
#   - Agent 2 (Diagnostician): RAG-augmented root cause analysis
#   - Agent 3 (Strategist): Recovery strategy inference
#   - Agent 4 (Compliance): Legal debate generation with RBI/TRAI citations
#   - Agent 6 (Analyst): Post-recovery pattern detection & insights
#   - Agent 7 (Conversational): NLU intent classification + empathetic replies
#   - RAG Embeddings: gemini-embedding-001 (3072-dim) for all 4 knowledge bases
# Model fallback chain: gemini-3.1-flash-lite → gemini-3.6-flash →
#                       gemini-3.5-flash-lite → gemini-flash-lite-latest

GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite


# ═══════════════════════════════════════════════════════════════════════
# ── Demo Configuration ────────────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════════════
# Your real phone/email for live demo (WhatsApp, SMS, Email, Voice).
# When you trigger a live demo scenario, real messages will be sent
# to these numbers/emails via actual API calls.

DEMO_PHONE_NUMBER=+91xxxxxxxxxx
DEMO_EMAIL=your-email@gmail.com
DEMO_CUSTOMER_NAME=Your Name


# ═══════════════════════════════════════════════════════════════════════
# ── App Settings ──────────────────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════════════
# MERCHANT_NAME: Displayed in all recovery messages and email templates.
# APP_ENV: development | staging | production
# FRONTEND_URL: Used for CORS and webhook callback URLs.

MERCHANT_NAME=StyleBazaar
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173


# ═══════════════════════════════════════════════════════════════════════
# ── Frontend Environment (frontend/.env) ──────────────────────────────
# ═══════════════════════════════════════════════════════════════════════
# These go in frontend/.env (separate from backend .env)
#
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_KEY=your-anon-key
# VITE_API_URL=http://localhost:8000
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
